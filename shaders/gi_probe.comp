#version 460 // GL_EXT_ray_query is written against GLSL 4.60 (see shaders/rt_shadow.comp)
#extension GL_EXT_ray_query : require

/**
 * @file shaders/gi_probe.comp
 * @brief The world-space radiance probe cache: one dispatch deposits the frame's screen-space GI into
 *        the grid cells it can see, and the rest spread it into the neighbouring cells.
 * @ingroup shaders
 *
 * WHY A WORLD-SPACE GRID, WHEN THERE IS ALREADY A SCREEN-SPACE CHAIN
 * The GI chain up to here (ssgi.comp -> ssgi_temporal.comp -> ssgi_spatial.comp) lives in screen space,
 * and that has two consequences the chain cannot fix from the inside. First, a ray that leaves the frame
 * or hits something hidden behind a nearer surface has no cached radiance to read, so it falls back to
 * the far-field environment probe - which is the SKY at infinity, not the light in the next room, and it
 * is the same value for a surface in the middle of the scene as for one on the roof. Second, everything
 * the chain knows is lost the moment the surface leaves the frame: turning the camera away throws away
 * its indirect light, and turning back re-discovers it over the next twenty frames.
 *
 * A grid of cells in WORLD space has neither problem. It is anchored to the scene rather than to the
 * view, so it survives the camera; and a ray that misses the screen can still be answered from wherever
 * it hit, because the grid is defined there. What it costs is resolution - a cell is a cell, and a
 * surface's radiance is smeared over the volume it occupies - which is why it is a CACHE that answers
 * for the places the screen cannot, and not a replacement for the screen-space estimate where there is
 * one. The tracer makes exactly that split (see rt_hit_radiance in shaders/ssgi.comp).
 *
 * HOW A CELL GETS ITS VALUE, AND WHY IT IS DONE THIS WAY
 * INJECTION (mode 0) projects the cell's centre into the current frame and, if the depth buffer there
 * holds a surface at that same distance, takes the screen-space chain's resolved radiance for that
 * pixel. This is a gather, one invocation per cell, so there are no atomics anywhere - which is what
 * keeps the cache to a plain RGBA16F 3D image and lets it run on a device without float atomics. A cell
 * whose centre lands off screen, behind the camera, or inside geometry simply keeps what it had: the
 * grid is a persistent cache, and a frame that cannot see a cell is not evidence that the cell is dark.
 *
 * PROPAGATION (mode 1) is a confidence-weighted 3x3x3 gather, run as a ping-pong between two grid
 * images so that no dispatch reads what it writes. It serves two purposes: it fills the cells the frame
 * could not see at all (the ones behind the camera, which is what makes this world-space rather than a
 * reprojected screen-space blur), and it is the only denoiser the injected values get - a cell is fed by
 * a single pixel's estimate, where the screen-space image is filtered by a whole chain.
 *
 * The fourth channel is TRUST, in [0, 1]: 1 for a cell the frame deposited into, halved for each
 * propagation step away from one, and the tracer scales the radiance it takes by it. That single number
 * does two jobs. It keeps uninitialised cells (trust 0) out of the averages, so an empty cell darkens
 * nothing; and it makes the spread FADE with distance, which matters because this blur has no geometry
 * test - nothing here knows whether a wall stands between two cells - so light does leak through thin
 * geometry. Leaking a wall's light at a quarter of its value, two cells away, is a stated approximation
 * rather than a runaway; a shadow-ray-gated propagation is the honest fix and a later step.
 *
 * LIMITATIONS, STATED: the blur is unoccluded (above); a cell is dominated by whatever surface the
 * frame's pixel at its centre happens to show, so a cell straddling two surfaces mixes them; and a
 * moving object's light stays behind in the grid after it has moved, because the grid is not
 * reprojected - it decays at the injection rate instead (pc.params.x).
 */

// One invocation per cell, in three dimensions. 4x4x4 = 64 threads per workgroup, so a 32^3 grid is
// 512 workgroups.
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

// Rays per cell per frame. Four is the first version's number, and the reasoning is recorded rather than
// tuned: 32768 cells at four rays is 131k rays, about half the screen-space tracer's 259k, which costs
// 0.58-0.9 ms in this project's own measurements. If that comes back acceptable the reference
// implementation's staleness-budgeted slice machinery is complexity this renderer does not need.
#define PROBE_RAYS 4

// The pass binds TWO sets: its own (set 1) and the shared scene set (set 0), which is where the top level
// structure, the material records and the texture array live. It reads none of them YET - the tracing that
// will fill the grid from geometry rather than from the screen is what needs them, and binding the set now
// is the plumbing that step requires.
layout(set = 1, binding = 0) uniform sampler2D gi_screen;     // this frame's resolved screen-space GI
layout(set = 1, binding = 1) uniform sampler2D gbuffer_depth; // full-resolution G-buffer depth
layout(set = 1, binding = 2) uniform sampler3D grid_src;      // the cells being read (propagation)
layout(set = 1, binding = 3, rgba16f) uniform image3D grid_dst; // the cells being written (both modes)
// ... and the geometry the filter needs in order to know which neighbours it may borrow light from: per
// cell, the vector from its centre to the surface the injection found at its screen position, with a
// validity flag in w. ONE image, not a pair: the injection owns this, and the ping-pong applies to
// radiance. Read and written in GENERAL, like the grids.
layout(set = 1, binding = 4, rgba16f) uniform image3D grid_surface;

// The scene set's top level structure: the geometry the probe cells will trace against, so that a cell can
// be filled from what its own rays find rather than from the pixel it happens to project to. Declared
// before it is used for the same reason the scene set was bound a slice earlier - the ray loop is next -
// and a pass whose layout does not name this binding cannot be created at all, which is one more reason
// this pass stays optional: a missing pipeline disables the cache and the tracer keeps its screen path.
layout(set = 0, binding = 16) uniform accelerationStructureEXT tlas;
// What the shared hit shading expects its INCLUDER to declare, because each pass reaches these through its
// own stage: the camera (the shared code needs the eye for the view vector) and the irradiance cube (a
// probe ray that hits nothing is answered by the sky, exactly as the tracer answers one).
layout(set = 0, binding = 0) uniform CameraUBO {
    mat4 view;
    mat4 proj;
    vec4 camera_pos;
} camera;
layout(set = 0, binding = 3) uniform samplerCube irradiance_sampler;

#include "hit_shading.glsl"
layout(push_constant) uniform GiProbePush {
    mat4 view_proj;     // world -> clip, for the injection's projection of a cell centre
    // xyz = the world position of cell (0,0,0)'s corner, w = one cell's size in world units. The grid
    // covers the scene's bounds, so the cell size falls out of the bounds and the resolution.
    vec4 grid_min_cell;
    // xyz = the camera's world position, w = unused. It is here for the one thing the injection needs
    // beyond the projection: the world-space direction of the ray through a cell, so that the surface it
    // finds can be recorded as an OFFSET from the cell rather than as a depth. The grid's extent no
    // longer needs a lane of its own - the image knows its size (imageSize in main()).
    vec4 camera_pos;
    // x = the injection's rate (the grid's own blend over frames), y = projection[2][2], z =
    // projection[3][2] (the view-depth linearization pair every depth test in this project uses),
    // w = the mode: 0 = inject, 1 = propagate
    vec4 params;
    // The acceleration structures' instance table, as the low and high halves of one device address - the
    // same shape the tracer's push carries, reinterpreted in the shader. Zero means there is no table, so a
    // cell has nothing to resolve a hit against. Not read yet: the loop that reads it is the rest of step B.
    uvec2 instance_table;
} pc;

/**
 * @brief view-space distance of a depth-buffer value
 * @param z_ndc a depth in [0,1]
 * @return a positive view-space distance
 * @note the same inversion the tracer and the denoiser use: z_view = proj_32 / (z_ndc + proj_22)
 */
float view_depth(float z_ndc) {
    return pc.params.z / (z_ndc + pc.params.y);
}

/** @brief whether @p cell is inside the grid (the dispatch is rounded up to the workgroup size) */
bool inside(ivec3 cell, ivec3 extent) {
    return all(greaterThanEqual(cell, ivec3(0))) && all(lessThan(cell, extent));
}

/** @brief a hash for a cell's ray sequence (the tracer's own hash chain, seeded per cell) */
uint hash_cell(ivec3 cell) {
    uint x = uint(cell.x) * 73856093u ^ uint(cell.y) * 19349663u ^ uint(cell.z) * 83492791u;
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

/** @brief the next uniform in [0,1) from @p state (the tracer's chain, so no table and no texture) */
float next_uniform(inout uint state) {
    state ^= state >> 16;
    state *= 0x7feb352du;
    state ^= state >> 15;
    state *= 0x846ca68bu;
    state ^= state >> 16;
    return float(state) * (1.0 / 4294967296.0);
}

/**
 * @brief a uniformly distributed direction on the sphere
 * @param u1 / @p u2 two uniforms in [0,1)
 * @note uniform rather than cosine-weighted, and that is a decision rather than an omission: a cache cell
 *       in empty space has NO surface normal, so there is no hemisphere to weight a cosine lobe towards.
 *       The sphere average is what a probe means, and it is why the reference implementation's probe traces
 *       are a 32x32 octahedral map of directions rather than a lobe.
 */
vec3 sphere_direction(float u1, float u2) {
    const float z = 1.0 - 2.0 * u1;
    const float r = sqrt(max(1.0 - z * z, 0.0));
    const float phi = 6.283185307179586 * u2;
    return vec3(r * cos(phi), r * sin(phi), z);
}

/**
 * @brief fill this cell from what its OWN rays find, instead of from the pixel it projects to
 * @param cell the cell to write
 *
 * This is the change that makes the cache view-independent. Until now a cell took the radiance of whatever
 * the frame happened to show at its screen position, so a cell the camera had never looked at held nothing
 * - and a whole class of approximations existed to paper over that (an unoccluded blur to spread light into
 * it, which is the leak step A removed). A cell now traces its own rays, shades what they hit with the
 * shared hit shading, and takes the sky when they hit nothing; what it holds is a fact about the scene.
 *
 * Rays start one cell diagonal away so a probe cannot hit its own cell, and directions are uniform over the
 * sphere because a cell in empty space has no normal to build a lobe around.
 */
void inject(ivec3 cell) {
    const vec4 stored = imageLoad(grid_dst, cell);
    const float rate = pc.params.x;
    if (rate <= 0.0) {
        return; // a rate of 0 is the off switch: the grid keeps whatever it has
    }
    const uint64_t table = (uint64_t(pc.instance_table.y) << 32u) | uint64_t(pc.instance_table.x);
    if (table == 0u) {
        return; // no structures to trace against this frame: the cell keeps what it has
    }
    const vec3 world = pc.grid_min_cell.xyz + (vec3(cell) + 0.5) * pc.grid_min_cell.w;
    const float start = pc.grid_min_cell.w * 1.7320508; // one cell diagonal

    vec3 radiance_sum = vec3(0.0);
    float nearest = 1e30;
    vec3 nearest_offset = vec3(0.0);
    uint state = hash_cell(cell);
    for (int i = 0; i < PROBE_RAYS; ++i) {
        const vec3 dir = sphere_direction(next_uniform(state), next_uniform(state));
        rayQueryEXT query;
        rayQueryInitializeEXT(query, tlas, gl_RayFlagsOpaqueEXT, 0xFF, world + dir * start, 0.01, dir, 1e30);
        while (rayQueryProceedEXT(query)) {
        }
        if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
            radiance_sum += texture(irradiance_sampler, dir).rgb; // nothing there: the sky answers
            continue;
        }
        const float t = rayQueryGetIntersectionTEXT(query, true);
        const vec3 hit_world = rayQueryGetWorldRayOriginEXT(query) + t * rayQueryGetWorldRayDirectionEXT(query);
        vec3 shaded = vec3(0.0);
        if (!shade_hit(query, hit_world, dir, table, pc.grid_min_cell.w * 2.0, shaded)) {
            radiance_sum += texture(irradiance_sampler, dir).rgb;
            continue;
        }
        radiance_sum += shaded;
        const float distance = length(hit_world - world);
        if (distance < nearest) {
            nearest = distance;
            nearest_offset = hit_world - world;
        }
    }

    // The blend is still the grid's own slow one: this cache is the part that has to survive the camera
    // turning away, so one frame's rays do not replace what it holds, they move it a little.
    const vec3 radiance = radiance_sum / float(PROBE_RAYS);
    imageStore(grid_dst, cell, vec4(mix(stored.rgb, radiance, rate), min(1.0, stored.a + rate)));

    // The geometry the filter tests visibility with: the offset to the NEAREST surface a ray found, which
    // is the one that would block a segment from this cell. A cell whose rays all escaped holds nothing, and
    // then no segment through it is blocked - which is the honest answer for empty space.
    imageStore(grid_surface, cell, vec4(nearest_offset, nearest < 1e29 ? 1.0 : 0.0));
}
/**
 * @brief whether the segment @p from -> @p to stays in front of the surface recorded at @p from
 * @param surface_at_from the offset from @p from to the surface its injection found (w = validity)
 * @param radius how close to the segment a surface has to be to be in the way
 * @return false when that surface blocks the segment
 * @note a surface blocks only when it lies BETWEEN the two points and close to the segment: a surface the
 *       segment never comes near is not an occluder, however far along it happens to sit.
 */
bool segment_clear(vec3 from, vec3 to, vec4 surface_at_from, float radius) {
    if (surface_at_from.w < 0.5) {
        return true; // nothing recorded here, so there is nothing to be occluded by
    }
    const vec3 segment = to - from;
    const float segment_length = length(segment);
    if (segment_length < 1e-6) {
        return true;
    }
    const vec3 direction = segment / segment_length;
    const float along = dot(surface_at_from.xyz, direction);
    if (along <= 0.0 || along >= segment_length) {
        return true; // the surface is not between the two cells
    }
    return length(surface_at_from.xyz - direction * along) > radius;
}

/**
 * @brief blend this cell with the neighbours it can SEE, and only with those
 * @param cell the cell to write
 *
 * Six axis neighbours rather than a 3x3x3 kernel, and each neighbour's weight is GATED by a visibility
 * test instead of scaled by a trust:
 *
 *  - the test is BIDIRECTIONAL: it asks whether the surface recorded at this cell lies between the two
 *    centres, and whether the surface recorded at the NEIGHBOUR does too. One direction alone misses a
 *    thin wall, and with a single surface offset per cell that is all this representation can offer;
 *  - a pair that fails DROPS OUT of both the sum and the weight, so the result is not a renormalised
 *    average. That is the entire point: a normalised unoccluded blur has unity DC gain, so it adds the
 *    same FRACTION of whatever every region already holds - which is exactly what this cache was measured
 *    doing (0.81% of the frame's darkest third, 0.75% of the middle, and only 0.06% of the brightest).
 *    Letting a rejected neighbour lower the total weight is what lets the outcome depend on the light;
 *  - the centre always contributes at weight 1, so a cell whose neighbours are all occluded keeps its own
 *    value instead of decaying towards the average of nothing;
 *  - the trust is no longer decayed per step. It describes whether a cell was ever filled, which the
 *    injection raises while it sees the cell, and visibility - not a decay - is what decides whether a
 *    neighbour may lend its light. The consequence is stated rather than hidden: cells the frame never
 *    saw now stay empty instead of being filled by an unoccluded spread, which is the leak this replaces;
 *    filling them honestly is what tracing from the cells will do.
 */

void propagate(ivec3 cell, ivec3 extent) {
    const vec4 center = texelFetch(grid_src, cell, 0);
    const vec4 center_surface = imageLoad(grid_surface, cell);
    const vec3 center_position = pc.grid_min_cell.xyz + (vec3(cell) + 0.5) * pc.grid_min_cell.w;
    const float radius = 0.5 * pc.grid_min_cell.w;

    vec3 sum = center.rgb; // the centre, at weight 1, always
    float weight_sum = 1.0;

    const ivec3 offsets[6] = ivec3[6](
        ivec3(1, 0, 0), ivec3(-1, 0, 0), ivec3(0, 1, 0), ivec3(0, -1, 0), ivec3(0, 0, 1), ivec3(0, 0, -1));
    for (int i = 0; i < 6; ++i) {
        const ivec3 at = cell + offsets[i];
        if (!inside(at, extent)) {
            continue;
        }
        const vec4 tap = texelFetch(grid_src, at, 0);
        if (tap.a <= 0.0) {
            continue; // never filled: there is nothing to lend
        }
        const vec3 neighbour_position = pc.grid_min_cell.xyz + (vec3(at) + 0.5) * pc.grid_min_cell.w;
        const vec4 neighbour_surface = imageLoad(grid_surface, at);
        if (!segment_clear(center_position, neighbour_position, center_surface, radius) ||
            !segment_clear(neighbour_position, center_position, neighbour_surface, radius)) {
            continue; // occluded in at least one direction: this neighbour's light does not reach us
        }
        sum += tap.rgb;
        weight_sum += 1.0;
    }
    imageStore(grid_dst, cell, vec4(sum / weight_sum, center.a));
}

void main() {
    const ivec3 extent = imageSize(grid_dst);
    const ivec3 cell = ivec3(gl_GlobalInvocationID.xyz);
    if (!inside(cell, extent)) {
        return; // the dispatch is rounded up to the workgroup size
    }
    if (pc.params.w < 0.5) {
        inject(cell);
    } else {
        propagate(cell, extent);
    }
}
