#version 460 // GL_EXT_ray_query is written against GLSL 4.60 (see shaders/rt_shadow.comp)
#extension GL_EXT_ray_query : require
// Shading a hit needs the geometry, and the only thing that reaches it without a descriptor is its
// device address (see the instance table below): a buffer reference, plus the 64-bit arithmetic that
// addresses it.
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// The bindless texture array (set 0 binding 1) is indexed by the material's own indices, exactly as
// shaders/surface.glsl indexes it: plain (uniform-per-draw there) indices into a partially-bound array.
#extension GL_EXT_nonuniform_qualifier : enable

/**
 * @file shaders/ssgi.comp
 * @brief Screen-space global illumination: one bounce of diffuse indirect light, at half resolution.
 * @ingroup shaders
 *
 * This is the tracer, and it is deliberately the CHEAP half of a global-illumination system: it
 * marches the depth buffer in screen space, so it can only see what is already on screen. A ray that
 * leaves the frame finds nothing and contributes nothing, which is why the result is added ON TOP of
 * the environment probe (shading.glsl's split-sum IBL) rather than replacing it - the probe is the
 * off-screen fallback, and it is also why `ssgi_intensity` exists: the probe already claims some of
 * this light, so the two together over-brighten unless the screen-space part is dialled back. Making
 * the off-screen half correct is what a ray query (or a surface cache) buys, and it is a later step.
 *
 * WHAT IT SAMPLES, AND WHY THAT MATTERS MORE THAN THE MARCH
 * The DIRECT radiance at a hit comes from `direct_radiance` = the HDR scene target as it stands after
 * the lighting stage. It is sampled by a pass that runs BEFORE the composite which adds this pass's
 * output, and the whole image is rewritten earlier in every frame (by the TAA resolve, or by the
 * G-buffer pass's clear when TAA is off). So the tracer can never read its own result.
 *
 * The rest of what a ray carries is `gi_resolve`, and that one IS a feedback: it holds the temporal
 * resolve's output, i.e. the accumulated indirect of the previous frame, and adding a fraction of it
 * (`pc.frame_info.z`, [render] ssgi_bounce) to a hit is what makes this a MULTI-bounce estimator - a
 * ray then returns the light LEAVING the surface it hit, indirect included, instead of the direct light
 * alone. The loop is deliberate and bounded, and the bound has to be stated because it is the whole
 * risk of the technique: the fraction is the gain, the surfaces' diffuse albedos (which the estimator
 * multiplies in at both ends) are below one, and what comes back is a temporal average rather than an
 * immediate echo of this frame's output - so the series converges instead of accumulating energy. It is
 * bounded but not free: the image being fed back already carries `pc.params.y` (ssgi_intensity), so the
 * loop's gain is `frame_info.z * ssgi_intensity`, which is why the runtime keeps the gain at or below
 * one and why a measurement (a static camera whose mean luminance neither decays nor grows over a
 * hundred frames) is the only thing that shows whether a given pair is stable. It also amplifies
 * whatever the fed-back image already contains, including the probe's approximation of the off-screen
 * light - one more reason the gain is a modest fraction rather than one, and a limit that a real
 * multi-bounce (a surface cache or a radiance probe grid) would remove.
 *
 * The output is `albedo * mean(radiance)` over cosine-weighted hemisphere rays, which is the
 * one-bounce diffuse estimator - the pi factors cancel by construction. It is written at HALF
 * resolution, because the signal is low-frequency and this is the pass whose cost scales with sample
 * count, and it is a RAW one: 2 rays per pixel is a field of white noise with the right average, and
 * what turns that into an image is the denoise chain - the temporal resolve in
 * shaders/ssgi_temporal.comp, which reads this pass's output as its `gi_trace` binding, and the
 * joint-bilateral filter in shaders/ssgi_spatial.comp after it. The composite samples the filter's
 * result, not this image: the three are separate so that the accumulation reads and writes different
 * images, and so that the spatial pass cannot feed back into the accumulation.
 *
 * Known limitations, stated rather than discovered later: geometry outside the frame contributes
 * nothing; thin occluders are missed between steps; and alphaMode MASK surfaces are solid here,
 * because a depth buffer has no alpha.
 */

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform CameraUBO {
    mat4 view;
    mat4 proj;
    vec4 camera_pos;
} camera;

// The G-buffer set (see runtime::ensure_gbuffer_descriptors): this pass reads the stored surface and
// the direct radiance, and writes the raw GI image the denoiser resolves. The bindings it does not
// declare (material, velocity) are still in the layout because the lighting stage and the debug view
// share it.
layout(set = 1, binding = 0) uniform sampler2D gbuffer_albedo;   // RGBA8: albedo.rgb + metallic
layout(set = 1, binding = 1) uniform sampler2D gbuffer_normal;   // RGBA16F: world normal.xyz
layout(set = 1, binding = 2) uniform sampler2D gbuffer_material; // RGBA8: .b = the material's baked AO (see deferred.frag)
layout(set = 1, binding = 3) uniform sampler2D gbuffer_depth;    // the pass's own 1x depth
layout(set = 1, binding = 5) uniform sampler2D direct_radiance;  // HDR scene target: DIRECT light only
// The temporal resolve's output, sampled at a hit to re-emit the indirect that arrived there (see the
// file header and pc.frame_info.z). It is the PREVIOUS frame's content of that image: the resolve
// overwrites it later in this same frame, after this pass has run, which is what keeps the feedback a
// delay rather than an echo of the frame it is part of.
layout(set = 1, binding = 7) uniform sampler2D gi_resolve;
// The probe, for the rays that leave the frame or hit something the camera cannot see: the irradiance
// map the lighting stage uses for its ambient, sampled along the RAY direction. This is what turns the
// traced path from "screen-space GI" into the full one-bounce diffuse indirect - see rt_hit_radiance.
layout(set = 0, binding = 3) uniform samplerCube irradiance_sampler;
layout(set = 1, binding = 6, rgba16f) uniform image2D gi_output; // half-res RAW indirect, one texel per invocation
// The scene's top level structure (scene set binding 16, declared only when the device has ray queries):
// the RAY-TRACED hit oracle, used instead of march() when pc.frame_info.y is set. Nothing else about the
// pass changes - the rays are the same cosine-weighted ones, the radiance still comes from the same
// direct-radiance image, and the same denoiser consumes the output.
layout(set = 0, binding = 16) uniform accelerationStructureEXT tlas;
// The world-space radiance probe cache (G-buffer set binding 9, declared only because the tracer is the
// pass that reads it): a sampler3D covering the scene's bounds, holding the indirect radiance the frames
// before this one deposited into each cell. It is the answer for a hit the SCREEN cannot resolve - off
// screen, or hidden behind a nearer surface - which is where the environment probe below is only the sky
// at infinity. Not sampled at all while its gain is 0.
layout(set = 1, binding = 9) uniform sampler3D gi_probe_grid;

layout(push_constant) uniform SsgiPush {
    mat4 inv_view_proj; // clip -> world (the same block deferred.frag uses)
    // x = ray length in view units, y = intensity, z = rays per pixel, w = steps per ray
    vec4 params;
    // x = projection[2][2], y = [3][2] (the view-depth linearization pair).
    // z/w are FREE LANES, deliberately: this block is exactly 128 bytes - the smallest push-constant
    // range Vulkan guarantees - so a lane has to be freed before one can be spent. The GI extent used to
    // live in z/w and does not need to: the storage image this pass writes knows its own size
    // (imageSize(gi_output) below), which is a fact about the dispatch rather than about the frame.
    // z is where the hit-shading mode will go (see rt_hit_radiance: today a hit's radiance is the
    // screen's, and the step that makes it the hit surface's own needs a lane to be A/B-able).
    vec4 proj_terms;
    // x = a per-frame counter, so the ray sequence differs every frame. A temporal denoiser needs
    // that: a fixed sequence would keep making the same mistake in the same place.
    // y = 1.0 when the rays are traced against the acceleration structures instead of marched (see
    // rt_hit_radiance). One lane rather than a field because the push block's size is a pipeline layout
    // constant every consumer shares.
    // z = the fraction of the previous frame's accumulated indirect a hit re-emits: the multi-bounce
    // gain ([render] ssgi_bounce). 0 makes this a single-bounce estimator, which is what every
    // measurement taken before the knob existed was taken with.
    // w = how much of the world-space probe cache's answer to add for a hit the screen cannot resolve
    // (see probe_radiance). 0 - the default - leaves those hits on the environment probe alone, and it
    // also means the cache is not even fetched.
    vec4 frame_info;
    // xyz = the world position of the probe grid's cell (0,0,0) CORNER, w = one cell's size in world
    // units. The grid's extent comes from textureSize() below rather than from a lane of its own: this
    // block is exactly 128 bytes, the smallest range Vulkan guarantees.
    vec4 probe_grid;
} pc;

/**
 * @brief view-space distance of a depth-buffer value
 * @param z_ndc the stored depth in [0,1]
 * @return a positive view-space distance
 * @note the same inversion the G-buffer debug view uses: the stored z is (proj_22 * z_view +
 *       proj_32) / -z_view, so z_view = proj_32 / (z_ndc + proj_22).
 */
float view_depth(float z_ndc) {
    return pc.proj_terms.y / (z_ndc + pc.proj_terms.x);
}

/**
 * @brief project a view-space point to the screen
 * @param view_pos the point
 * @param out_ndc_z the point's NDC depth
 * @return the UV, in the same convention as the G-buffer's v_uv (0,0 top-left - the y flip is
 *         already inside camera.proj, which is what makes a texture() at this UV line up)
 */
vec2 project_to_uv(vec3 view_pos, out float out_ndc_z) {
    const vec4 clip = camera.proj * vec4(view_pos, 1.0);
    const vec3 ndc = clip.xyz / clip.w;
    out_ndc_z = ndc.z;
    return ndc.xy * 0.5 + 0.5;
}

/**
 * @brief a cosine-weighted direction in the hemisphere around @p n
 * @param n the surface normal (any space; the result is in the same one)
 * @param u1 / @p u2 two uniforms in [0,1)
 * @return a unit direction, distributed as cos(theta)/pi
 *
 * Cosine weighting is what makes the estimator `albedo * mean(radiance)` with no extra factor, and it
 * concentrates the rays where the cosine term is large - which is both correct and cheaper than
 * uniform sampling for the same noise.
 */
vec3 cosine_direction(vec3 n, float u1, float u2) {
    const float r = sqrt(u1);
    const float phi = 6.283185307179586 * u2;
    const vec3 helper = abs(n.x) < 0.9 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
    const vec3 tangent = normalize(cross(helper, n));
    const vec3 bitangent = cross(n, tangent);
    return normalize(tangent * (r * cos(phi)) + bitangent * (r * sin(phi)) + n * sqrt(max(1.0 - u1, 0.0)));
}

/** @brief a PCG-style integer hash: the ray sequence's only source of randomness */
uint hash_u32(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

/** @brief the next uniform in [0,1) from @p state (a hash chain, so no table and no texture) */
float next_uniform(inout uint state) {
    state = hash_u32(state);
    return float(state) * (1.0 / 4294967296.0);
}

/**
 * @brief march @p dir from @p origin and report the first screen-space hit
 * @param origin the view-space start (already pushed off the surface)
 * @param dir the unit view-space direction
 * @param max_distance how far to march, in view units
 * @param steps how many samples to take along the way
 * @param out_uv the UV of the hit
 * @return true when the ray passed behind geometry that the depth buffer knows about
 *
 * The test is "is this sample behind the surface the depth buffer holds here": sample_view >
 * buffer_view. The tolerance grows with distance because a screen-space march has no idea how the
 * surface is sloped - a fixed epsilon either self-hits on a steep surface or lets a ray pass through
 * a distant wall. A ray that runs off the frame or finds nothing is a miss, and a miss contributes
 * zero: that is the honest answer for a technique that cannot see off screen.
 */
bool march(vec3 origin, vec3 dir, float max_distance, int steps, out vec2 out_uv) {
    const float step_length = max_distance / float(steps);
    for (int i = 1; i <= steps; ++i) {
        const vec3 point = origin + dir * (step_length * float(i));
        float ndc_z = 0.0;
        const vec2 uv = project_to_uv(point, ndc_z);
        if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
            return false; // off screen: nothing to hit
        }
        const float buffer_ndc = texture(gbuffer_depth, uv).r;
        if (buffer_ndc >= 1.0) {
            continue; // empty space (the cleared far plane): keep marching
        }
        const float buffer_view = view_depth(buffer_ndc);
        const float sample_view = -point.z; // view space looks down -Z, so depth is the negation
        if (sample_view > buffer_view + max(0.02 * sample_view, 0.02)) {
            out_uv = uv;
            return true;
        }
    }
    return false;
}

/**
 * @brief what the surface at a hit re-emits along the ray: the multi-bounce term
 * @param uv the hit, in full-resolution screen UV (the resolve image is half-res; the sampler filters)
 * @return `frame_info.z * ` the previous frame's accumulated indirect there, or 0 when the gain is off
 * @note the fetch sits inside the branch rather than being multiplied by a zero gain. The image has no
 *       defined contents on the frames before it has been resolved once (the runtime transitions it to
 *       SHADER_READ so the descriptor is legal, but its texels are whatever the allocation held), and
 *       zero times a NaN is a NaN - which the temporal filter would then carry into the image. Reading
 *       nothing when the gain is zero is both correct and free.
 */
vec3 bounce_radiance(vec2 uv) {
    return pc.frame_info.z > 0.0 ? pc.frame_info.z * texture(gi_resolve, uv).rgb : vec3(0.0);
}

/**
 * @brief the world-space probe cache's answer for a hit the frame cannot resolve
 * @param world the hit's world position
 * @return the indirect radiance the cache holds there, scaled by the cell's trust, or 0 when it is off
 *
 * This is the half of the fallback the environment probe cannot provide. The probe is the SKY - a
 * far-field environment, the same value in the middle of a room as on the roof - so a ray that lands on
 * a surface the camera cannot see comes back with an approximation that has nothing to do with where it
 * landed. The cache, being anchored to the world (see shaders/gi_probe.comp), does: the position becomes
 * a cell coordinate and the LINEAR sampler interpolates between the eight cells around it.
 *
 * The fourth channel is the cell's TRUST, and it is what keeps a cell no frame has deposited into from
 * answering as black: it scales what the cell holds instead, and contributes nothing at all at 0. The
 * fetch itself sits inside the gain branch, for the same reason the multi-bounce fetch does - the grid's
 * texels are undefined until the pass that fills it has run once, and zero times a NaN is a NaN.
 */
vec3 probe_radiance(vec3 world) {
    if (pc.frame_info.w <= 0.0) {
        return vec3(0.0);
    }
    const vec3 cell = (world - pc.probe_grid.xyz) / pc.probe_grid.w;
    const vec3 uvw = (cell + 0.5) / vec3(textureSize(gi_probe_grid, 0));
    if (any(lessThan(uvw, vec3(0.0))) || any(greaterThan(uvw, vec3(1.0)))) {
        return vec3(0.0); // outside the grid's cube (the scene's bounds): the cache has nothing to say
    }
    const vec4 cached = texture(gi_probe_grid, uvw);
    return pc.frame_info.w * cached.rgb * cached.a;
}

// The light UBO, declared as the same truncated PREFIX shaders/rt_shadow.comp uses: the sun's direction
// is the only field this pass reads (the full block's layout is the lighting stage's business).
layout(set = 0, binding = 7) uniform LightUBO {
    mat4 light_view_proj[4];
    vec4 light_dir;
} light;
// The IBL's other two halves (the irradiance cube above is the third): the prefiltered environment and
// the BRDF integration LUT. A shaded hit has to reproduce the lighting stage's split-sum ambient, or the
// indirect it reports for that surface would disagree with what the screen shows for it.
layout(set = 0, binding = 2) uniform samplerCube env_sampler;
layout(set = 0, binding = 4) uniform sampler2D brdf_lut_sampler;
// The scene's material table and its bindless texture array (set 0 bindings 5 and 1, the same two
// shaders/surface.glsl reads). Declared here rather than included from there: that file also declares the
// camera UBO and the IBL cubes this pass already has, and re-declaring a binding is a compile error.
struct hit_material {
    uvec4 tex_indices; // albedo, metallic-roughness, normal, occlusion
    uint emissive_index;
    float alpha_cutoff;
    float occlusion_strength;
    uint _pad;
    vec4 base_color_factor;
    vec4 emissive_factor;
    float metallic_factor;
    float roughness_factor;
    float normal_scale;
    uint flags; // bit0 normal map, bit1 occlusion, bit2 emissive, bit3 double sided, bit4 MASK
};
layout(set = 0, binding = 5) readonly buffer HitMaterials {
    hit_material materials[];
} hit_materials;
layout(set = 0, binding = 1) uniform sampler2D scene_textures[];

// The instance table (vulkan.acceleration_structure::instance_record, 96 bytes) reached through the
// device address the runtime pushes - which is also the MODE SWITCH: 0 means the structures are not built
// or hit shading is off, and every hit falls back to sampling the screen. A buffer reference rather than
// a descriptor because the buffers it points at (the geometry) already carry device addresses for the
// acceleration-structure build, so this costs no binding of its own.
struct hit_instance {
    uint64_t vertex_address; // the vertex buffer's base
    uint64_t index_address;  // the index buffer's base
    mat4 model;              // object -> world, for the vertex normal (the position comes from the ray)
    uint vertex_stride;
    uint index_type;     // VkIndexType: 0 = uint32, 1 = uint16
    uint material_index;
    uint primitive_index;
};
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer InstanceTable {
    hit_instance records[];
};
// The geometry itself, read as untyped 4-byte words: the vertex is a 64-byte interleaved record in an
// implementation-defined struct, so addressing it as floats is what makes the offsets (0, 3, 6) read
// `vec3 position; vec3 normal; vec2 uv` without depending on a std430 struct layout that does not exist.
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer GeometryFloats {
    float values[];
};
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer GeometryWords {
    uint values[];
};

/** @brief the Schlick approximation, the same one shading.glsl uses for direct and IBL specular */
vec3 fresnel_schlick(float cos_theta, vec3 f0) {
    return f0 + (vec3(1.0) - f0) * pow(clamp(1.0 - cos_theta, 0.0, 1.0), 5.0);
}

/**
 * @brief the instance table's device address, or 0 when a hit cannot be shaded
 *
 * The two lanes carry the low and high halves of one 64-bit address, bit-reinterpreted: a push constant
 * is raw bytes, so a float lane holds an address's half exactly as written, and this is the one place in
 * the pass where a lane is not a number. It is also the feature's switch - see shade_hit.
 */
uint64_t instance_table_address() {
    return (uint64_t(floatBitsToUint(pc.proj_terms.w)) << 32u) | uint64_t(floatBitsToUint(pc.proj_terms.z));
}

/**
 * @brief the material's surface at a hit, built from the triangle the ray actually hit
 * @param instance the hit instance's table entry
 * @param triangle the hit triangle's index within that instance's geometry
 * @param bary the hit's barycentric coordinates (x for vertex 1, y for vertex 2; vertex 0 takes the rest)
 * @param front_facing whether the ray met the triangle's front face
 * @param out_uv the interpolated texture coordinates
 * @return the hit surface's object-space normal, and through @p out_uv its UVs
 *
 * The TANGENT FRAME IS SOLVED FROM THE TRIANGLE, not from screen-space derivatives: surface.glsl builds
 * its TBN from dFdx/dFdy of the world position and the UVs because a fragment shader has nothing else,
 * and this pass has no derivatives at all - but it does have the triangle's three vertices and their
 * UVs, which is exactly what the derivative solve is approximating. So the analytic frame is both the
 * only option here and the better one: it is per-triangle rather than per-quad.
 */
vec3 hit_surface(hit_instance instance, uint triangle, vec2 bary, bool front_facing, out vec2 out_uv) {
    GeometryWords indices = GeometryWords(instance.index_address);
    const uint base = triangle * 3u;
    uint vertex_indices[3];
    for (uint k = 0u; k < 3u; ++k) {
        const uint i = base + k;
        // VkIndexType: UINT16 is 0 and UINT32 is 1 (UINT8_EXT is not something the loader produces), so
        // the 16-bit case is the one that has to read a half of a word. Getting this backwards does not
        // mis-shade a triangle - it reads a different INDEX, whose vertex lies outside the buffer.
        if (instance.index_type == 0u) { // VK_INDEX_TYPE_UINT16
            const uint word = indices.values[i >> 1u];
            vertex_indices[k] = (i & 1u) == 0u ? (word & 0xFFFFu) : (word >> 16u);
        } else {
            vertex_indices[k] = indices.values[i]; // VK_INDEX_TYPE_UINT32
        }
    }
    vec3 positions[3];
    vec3 normals[3];
    vec2 uvs[3];
    for (uint k = 0u; k < 3u; ++k) {
        // The stride is in bytes and the buffer reference is in floats, so the address arithmetic stays
        // in bytes and the word index is the byte offset divided by four.
        GeometryFloats vertex = GeometryFloats(instance.vertex_address + uint64_t(vertex_indices[k]) * uint64_t(instance.vertex_stride));
        positions[k] = vec3(vertex.values[0], vertex.values[1], vertex.values[2]);
        normals[k] = vec3(vertex.values[3], vertex.values[4], vertex.values[5]);
        uvs[k] = vec2(vertex.values[6], vertex.values[7]);
    }
    // EXT_ray_query reports the barycentrics of vertices 1 and 2; vertex 0 takes whatever is left.
    const vec3 weights = vec3(1.0 - bary.x - bary.y, bary.x, bary.y);
    const vec3 object_normal = normalize(normals[0] * weights.x + normals[1] * weights.y + normals[2] * weights.z);
    out_uv = uvs[0] * weights.x + uvs[1] * weights.y + uvs[2] * weights.z;

    const vec3 normal = normalize(mat3(instance.model) * object_normal);
    const hit_material mat = hit_materials.materials[instance.material_index];
    if ((mat.flags & 1u) == 0u) {
        // No normal map: the interpolated vertex normal is the shading normal. The double-sided flip is
        // the one gl_FrontFacing stands in for in a fragment shader - here the ray query reports whether
        // the ray met the front face, which is the same fact.
        return (mat.flags & 8u) != 0u && !front_facing ? -normal : normal;
    }
    // The analytic tangent frame: the triangle's own edges and UV deltas, which is what the derivative
    // solve in surface.glsl approximates from neighbouring fragments.
    const vec3 edge1 = positions[1] - positions[0];
    const vec3 edge2 = positions[2] - positions[0];
    const vec2 delta1 = uvs[1] - uvs[0];
    const vec2 delta2 = uvs[2] - uvs[0];
    const float determinant = delta1.x * delta2.y - delta2.x * delta1.y;
    if (abs(determinant) < 1e-12) {
        return (mat.flags & 8u) != 0u && !front_facing ? -normal : normal; // degenerate UVs: no frame
    }
    const vec3 tangent = normalize(mat3(instance.model) * ((delta2.y * edge1 - delta1.y * edge2) / determinant));
    const vec3 bitangent = normalize(mat3(instance.model) * ((delta1.x * edge2 - delta2.x * edge1) / determinant));
    const vec3 mapped = texture(scene_textures[mat.tex_indices.z], out_uv).rgb * 2.0 - 1.0;
    const vec3 scaled = normalize(vec3(mapped.xy * mat.normal_scale, mapped.z));
    const vec3 shading = normalize(mat3(tangent, bitangent, normal) * scaled);
    return (mat.flags & 8u) != 0u && !front_facing ? -shading : shading;
}

/**
 * @brief the radiance leaving the surface a ray hit, evaluated from the geometry rather than the screen
 * @param query the finished ray query (its committed intersection is a real hit)
 * @param hit_world the hit's world position (the ray's origin plus t times its direction)
 * @param dir the world-space ray direction
 * @param out_radiance the surface's outgoing radiance toward the ray's origin
 * @return false when the hit cannot be shaded (the table has no entry for it), so the caller falls back
 *
 * WHY THIS EXISTS: sampling the screen's direct-radiance image at a hit is what the traced path did, and
 * it has two costs. It cannot answer for a hit the camera does not see (off screen, or hidden behind a
 * nearer surface) - those fall back to a probe, which is an approximation of the light WHERE THE RAY
 * STARTED rather than radiance arriving from where it landed - and it makes every sample depend on the
 * frame the camera happens to be showing, so a surface's indirect light changes when the camera moves.
 * Shading the hit from the geometry removes both: the answer depends on the hit and the lights alone.
 *
 * WHAT IT DOES NOT REPRODUCE, stated rather than discovered later: the toon and non-PBR presets of
 * shading.glsl's `brdf_model`/`diffuse_model` (this is the default PBR path), alphaMode MASK (the
 * geometry is built OPAQUE, so a MASK surface is solid to the ray - the documented behaviour of every
 * traced effect in this engine), skinning and morphing (the structures hold the bind pose), and the
 * punctual-light cluster, which is a screen-space structure a hit outside the frame has no entry in.
 */
bool shade_hit(rayQueryEXT query, vec3 hit_world, vec3 dir, out vec3 out_radiance) {
    InstanceTable table = InstanceTable(instance_table_address());
    const hit_instance instance = table.records[rayQueryGetIntersectionInstanceCustomIndexEXT(query, true)];
    const hit_material mat = hit_materials.materials[instance.material_index];

    vec2 uv = vec2(0.0);
    const vec3 normal = hit_surface(instance, rayQueryGetIntersectionPrimitiveIndexEXT(query, true), rayQueryGetIntersectionBarycentricsEXT(query, true), rayQueryGetIntersectionFrontFaceEXT(query, true), uv);

    const vec3 base_color = mat.base_color_factor.rgb * texture(scene_textures[mat.tex_indices.x], uv).rgb;
    const float metallic = clamp(mat.metallic_factor * texture(scene_textures[mat.tex_indices.y], uv).b, 0.0, 1.0);
    const float roughness = clamp(mat.roughness_factor * texture(scene_textures[mat.tex_indices.y], uv).g, 0.045, 1.0);
    const float ao = (mat.flags & 2u) != 0u ? mix(1.0, texture(scene_textures[mat.tex_indices.w], uv).r, mat.occlusion_strength) : 1.0;
    const vec3 emissive = (mat.flags & 4u) != 0u ? mat.emissive_factor.rgb * texture(scene_textures[mat.emissive_index], uv).rgb : vec3(0.0);

    const vec3 v = normalize(camera.camera_pos.xyz - hit_world);
    const vec3 f0 = mix(vec3(0.04), base_color, metallic);
    const vec3 kd = (1.0 - f0) * (1.0 - metallic);

    // The sun, with a shadow ray instead of a shadow map: this pass already has the acceleration
    // structures, and a ray answers the visibility question for the exact point rather than for a texel
    // of a cascade. The radiance is the same literal the lighting stage uses, so the two agree.
    //
    // The self-intersection bias follows the engine's own convention for pushing a ray off a surface: an
    // offset ALONG THE NORMAL that is a fraction of the scene-relative ray length (pc.params.x), which is
    // what makes one number mean the same thing on a 1.6-unit model and on Sponza - the cascaded shadow
    // maps offset by twice a shadow texel's world size, which is the same idea expressed in texels.
    //
    // It is NOT what decides this term's weight, and the measurement says so: quadrupling the offset (a
    // fixed 0.01 to 0.045 on Sponza) moved the frame by 0.045 of a mean brightness out of the 3.23 the
    // shadow ray removes in total. So what the ray occludes is real geometry rather than the hit's own
    // triangle - but it occludes MORE than the cascaded maps do (the ray removes 3.23, the maps remove
    // 2.11: a shadow-free variant is 63.51, the ray 60.28, the screen 61.40), and that gap is not yet
    // explained. The candidates left are the ones a cascade cannot see - occluders above the camera, and
    // the cascade's own resolution and depth range - but until it is isolated this term is the shaded
    // path's open question, not a difference to call a correction.
    float sun_visibility = 1.0;
    {
        rayQueryEXT shadow_query;
        rayQueryInitializeEXT(shadow_query, tlas, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0xFF,
                             hit_world + normal * max(0.01, pc.params.x * 0.02), 0.01, light.light_dir.xyz, 1e30);
        while (rayQueryProceedEXT(shadow_query)) {
        }
        if (rayQueryGetIntersectionTypeEXT(shadow_query, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
            sun_visibility = 0.0;
        }
    }
    const vec3 l = normalize(light.light_dir.xyz);
    const float ndotl = max(dot(normal, l), 0.0);
    const float ndotv = max(dot(normal, v), 0.0);
    vec3 direct = vec3(0.0);
    if (ndotl > 0.0 && sun_visibility > 0.0) {
        // The default PBR preset of shading.glsl's evaluate_direct_light: Lambert + GGX with the Smith
        // visibility term, which is the path every measurement in this project was taken on.
        const vec3 h = normalize(v + l);
        const float a2 = roughness * roughness;
        const float ndoth = max(dot(normal, h), 0.0);
        const float denominator = ndoth * ndoth * (a2 - 1.0) + 1.0;
        const float ndf = a2 / max(3.141592653589793 * denominator * denominator, 1e-8);
        const float a = sqrt(a2);
        const float vis = 0.5 / max(ndotl * (ndotv * (1.0 - a) + a) + ndotv * (ndotl * (1.0 - a) + a), 1e-6);
        const vec3 specular = ndf * vis * fresnel_schlick(max(dot(h, v), 0.0), f0);
        direct = (kd * base_color / 3.141592653589793 + specular) * (vec3(7.5) * ndotl);
    }

    // The split-sum IBL ambient, as the lighting stage computes it (the same two lookups and the same
    // combination, so a shaded hit and the screen agree about a surface's ambient).
    const vec3 ibl_diffuse = texture(irradiance_sampler, normal).rgb;
    const vec3 ibl_specular = textureLod(env_sampler, normalize(reflect(-v, normal)), roughness * float(max(textureQueryLevels(env_sampler) - 1, 0))).rgb;
    const vec2 f_ab = texture(brdf_lut_sampler, vec2(ndotv, roughness)).rg;
    const vec3 fr = max(vec3(1.0 - roughness), f0) - f0;
    const vec3 k_s = f0 + fr * pow(1.0 - ndotv, 5.0);
    const vec3 fssess = k_s * f_ab.x + f_ab.y;
    const float ems = 1.0 - (f_ab.x + f_ab.y);
    const vec3 f_avg = f0 + (1.0 - f0) / 21.0;
    const vec3 fmsems = ems * fssess * f_avg / max(1.0 - f_avg * ems, vec3(1e-4));
    const vec3 ambient = ibl_diffuse * base_color * ao * (1.0 - metallic);
    const vec3 specular_ibl = ibl_specular * (fssess + fmsems) * ao;

    out_radiance = ambient + direct + specular_ibl + emissive;
    return true;
}

/**
 * @brief trace @p dir from @p origin and report the radiance of what it hits
 * @param origin the WORLD-space start (already pushed off the surface)
 * @param dir the unit world-space direction
 * @param max_distance how far to trace, in world units
 * @param out_hit whether the ray found any surface at all
 * @return the radiance at the hit, or 0 when the hit contributes nothing
 *
 * TWO WAYS TO ANSWER A HIT, and which one runs is the runtime's decision:
 *  - the hit is SHADED from the geometry it landed on (see shade_hit), which is what the instance table
 *    the runtime publishes switches on. The answer depends on the hit surface and the lights alone, so a
 *    hit the camera cannot see is answered correctly instead of approximated;
 *  - or the hit is REPROJECTED into the frame and the lighting stage's direct radiance is sampled there,
 *    which is what every earlier measurement was taken with. It is the A/B, and it is also what a frame
 *    without a published table gets.
 * The rest of this comment describes the second one.
 *
 * This is the same estimator as march() with a different hit oracle. marra() has to decide "did I hit
 * something" from a depth buffer it samples along the way, which is why it needs a distance-scaled
 * tolerance, misses anything thinner than a step, and calls a ray that leaves the frame a miss; a ray
 * query answers the same question exactly. The radiance still comes from the screen's DIRECT radiance
 * image, which is what keeps the result comparable to the marched version and keeps this pass an
 * ADDITION to the environment probe rather than a replacement for it: a hit that is off screen (or
 * hidden behind a nearer surface on screen) contributes nothing, exactly as before, so the probe still
 * owns the off-screen light and `ssgi_intensity` still reconciles the two.
 *
 * That last part is deliberate for this step. Filling off-screen hits with the probe's irradiance would
 * make this pass reproduce the ambient the shading stage ALREADY adds for every pixel, i.e. it would
 * count the off-screen part twice: doing that correctly means the lighting stage stops adding its own
 * diffuse ambient when this pass covers it, which is a change to what the ambient MEANS and belongs in
 * a step of its own with its own measurement.
 *
 * The multi-bounce term is added on the SCREEN-VALIDATED path only. The three probe returns below are
 * rays that found no surface within their length, or whose hit the camera cannot see: there is no
 * surface there to re-emit anything, and the probe value is an estimate of the ambient at the ORIGIN of
 * the ray, not radiance arriving from that direction - so scaling it by the gain would amplify an
 * approximation rather than close a light path.
 *
 * The world-space cache IS added on two of those three returns, and the difference is the whole reason
 * it exists: a hit that is off screen or hidden still has a world POSITION, and the cache is defined
 * there (see probe_radiance). It is the one fallback that knows where the ray landed.
 */
vec3 rt_hit_radiance(vec3 origin, vec3 dir, float max_distance, out bool out_hit) {
    out_hit = false;
    rayQueryEXT query;
    rayQueryInitializeEXT(query, tlas, gl_RayFlagsOpaqueEXT, 0xFF, origin, 0.01, dir, max_distance);
    while (rayQueryProceedEXT(query)) {
    }
    if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
        // Nothing within the ray''s length: the probe answers for that direction.
        return texture(irradiance_sampler, dir).rgb;
    }
    out_hit = true;

    // Reproject the hit into the frame and take the direct radiance the lighting stage wrote there -
    // but only if the depth buffer's surface at that pixel IS the surface that was hit. Reprojection
    // alone cannot know that: the ray can hit something the camera cannot see (behind a wall, or outside
    // the frame), and sampling the visible surface's radiance for it would invent light.
    // The hit's world position from the distance along the ray: GL_EXT_ray_query has no
    // "intersection world position" query - only the t and the ray (getting the position itself would
    // mean interpolating the triangle, which needs the vertex data and barycentrics).
    const float hit_t = rayQueryGetIntersectionTEXT(query, true);
    const vec3 hit_world = rayQueryGetWorldRayOriginEXT(query) + hit_t * rayQueryGetWorldRayDirectionEXT(query);

    // Shading the hit from the geometry, when the runtime has published an instance table: the answer
    // then depends on the hit surface and the lights alone, which is what lets a hit the camera cannot
    // see be answered at all (see shade_hit). The screen path below stays for the frames where it is
    // off - it is the A/B, and it is also what a device whose structures are not built yet gets.
    if (instance_table_address() != 0u) {
        vec3 shaded = vec3(0.0);
        if (shade_hit(query, hit_world, dir, shaded)) {
            // The shaded surface's own outgoing radiance: direct sun, the split-sum IBL ambient and its
            // emissive. The screen-space multi-bounce feedback is deliberately NOT added on top: the
            // ambient a shaded hit carries already IS its indirect estimate, so adding the feedback (which
            // is injected from this same chain) would count that light twice.
            return shaded;
        }
    }

    const vec3 hit_view = (camera.view * vec4(hit_world, 1.0)).xyz;
    float ndc_z = 0.0;
    const vec2 hit_uv = project_to_uv(hit_view, ndc_z);
    if (hit_uv.x < 0.0 || hit_uv.x > 1.0 || hit_uv.y < 0.0 || hit_uv.y > 1.0) {
        // Off screen: no cached radiance exists for it on screen, so the environment probe answers - and
        // the world-space cache, which does know where this hit is (see probe_radiance).
        return texture(irradiance_sampler, dir).rgb + probe_radiance(hit_world);
    }
    const float buffer_ndc = texture(gbuffer_depth, hit_uv).r;
    const float hit_view_depth = -hit_view.z; // view space looks down -Z
    if (buffer_ndc >= 1.0 || abs(view_depth(buffer_ndc) - hit_view_depth) > 0.05 * hit_view_depth) {
        // The visible surface there is a different one: the hit is hidden, and the same answer as above.
        return texture(irradiance_sampler, dir).rgb + probe_radiance(hit_world);
    }
    return texture(direct_radiance, hit_uv).rgb + bounce_radiance(hit_uv);
}

void main() {
    const ivec2 gi_extent = imageSize(gi_output);
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= gi_extent.x || pixel.y >= gi_extent.y) {
        return; // the dispatch is rounded up to the workgroup size
    }

    const vec2 uv = (vec2(pixel) + 0.5) / vec2(gi_extent);
    const float depth_ndc = texture(gbuffer_depth, uv).r;
    if (depth_ndc >= 1.0) {
        imageStore(gi_output, pixel, vec4(0.0)); // background: no surface, no bounce
        return;
    }

    const int rays = int(pc.params.z);
    const int steps = int(pc.params.w);
    if (rays <= 0 || steps <= 0) {
        imageStore(gi_output, pixel, vec4(0.0));
        return;
    }

    // This pixel's surface, in both spaces: world (to match the G-buffer's stored normal) and view
    // (which is where the march happens, because projection needs the view-space point anyway).
    const vec4 clip = vec4(uv * 2.0 - 1.0, depth_ndc, 1.0);
    const vec4 world_h = pc.inv_view_proj * clip;
    const vec3 view_pos = (camera.view * vec4(world_h.xyz / world_h.w, 1.0)).xyz;

    const vec3 normal_view = normalize(mat3(camera.view) * texture(gbuffer_normal, uv).xyz);
    const vec3 albedo = texture(gbuffer_albedo, uv).rgb;
    // The world-space surface, which is where a ray query runs (the acceleration structures are in world
    // space): the G-buffer normal already is, and the world position falls out of the same
    // inverse-projection the view-space position does.
    const vec3 world_pos = world_h.xyz / world_h.w;
    const vec3 normal_world = normalize(texture(gbuffer_normal, uv).xyz);
    const bool traced = pc.frame_info.y > 0.5;

    // A per-pixel, per-frame seed: the ray sequence has to change between frames or a temporal
    // filter would be fed the same error every frame instead of an average of different errors.
    uint state = hash_u32(uint(pixel.x) + uint(pixel.y) * 4096u + uint(pc.frame_info.x) * 2654435761u);

    const float radius = pc.params.x;
    vec3 radiance_sum = vec3(0.0);
    for (int r = 0; r < rays; ++r) {
        const vec3 dir = cosine_direction(normal_view, next_uniform(state), next_uniform(state));
        // Start off the surface by a fraction of the ray length. Starting exactly on it makes the
        // first step compare against the surface's own depth, which self-hits on any slope.
        const vec3 origin = view_pos + normal_view * (radius * 0.02);
        if (traced) {
            // A separate direction/origin in world space: the cosine lobe has to be built around the
            // WORLD normal, and drawing the two uniforms from the same state keeps the sequence - and so
            // the noise - identical to the marched path's for the same pixel and frame.
            const vec2 u = vec2(next_uniform(state), next_uniform(state));
            const vec3 dir_world = cosine_direction(normal_world, u.x, u.y);
            const vec3 origin_world = world_pos + normal_world * (radius * 0.02);
            bool hit = false;
            radiance_sum += rt_hit_radiance(origin_world, dir_world, radius, hit);
        } else {
            vec2 hit_uv;
            if (march(origin, dir, radius, steps, hit_uv)) {
                radiance_sum += texture(direct_radiance, hit_uv).rgb + bounce_radiance(hit_uv);
            }
        }
    }

    // UNSIGNED radiance, always: what the rays found, times this surface's albedo (and, on the traced
    // path, its baked AO). Every consumer downstream means "radiance arriving here" - the temporal
    // accumulation, the spatial filter, and a bounce that re-emits what arrived - so the image has to
    // stay a radiance and not a correction term.
    //
    // The traced path's rays fall back to the probe off screen, which means they estimate the whole
    // diffuse indirect INCLUDING the ambient the lighting stage adds for every pixel, so something has
    // to remove that part or it is counted twice. That subtraction used to happen HERE, as a signed
    // difference - and it made this image a non-radiance quantity, which is exactly what made the first
    // attempt at a multi-bounce feedback cancel itself out (a bounce that re-emits `indirect - ambient`
    // feeds the loop a value that goes to zero as the loop converges). It now happens in the spatial
    // filter instead (see ssgi_spatial.comp): that pass still has the surface the ambient belongs to, and
    // it is the last one before the composite, so nothing downstream of this line sees anything but
    // radiance.
    // radiance. On a frame with a non-zero bounce gain the sum above already carries the higher-order
    // bounces, for the same reason: what a ray re-emitted was radiance too.
    const float traced_ao = traced ? texture(gbuffer_material, uv).b : 1.0;
    const vec3 indirect = albedo * (radiance_sum / float(rays)) * pc.params.y * traced_ao;
    imageStore(gi_output, pixel, vec4(indirect, 1.0));
}
