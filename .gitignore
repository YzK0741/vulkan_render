#clion folders
cmake-build-*/
build-*-clang64/
build-debug/
build-release/
#sanitizer build (ASan/UBSan, local verification only - see tests/)
build-asan/
.idea/

#doxygen generated output
docs/html/
docs/latex/

#compiled shaders: the build produces them (into <build>/shaders), so they are never committed and
#never hand-synced with their .glsl sources - editing a shader and rebuilding is the whole workflow
*.spv

#runtime artifacts (flushed logs + Dear ImGui panel-layout persistence)
debug.log
debug.log.old
imgui_layout.ini
#local startup config (generated from config.example.toml by the setup scripts)
config.toml
.commit-msg.tmp
